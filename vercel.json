{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && NODE_OPTIONS=--max-old-space-size=7168 npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://new-life-clinic.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
